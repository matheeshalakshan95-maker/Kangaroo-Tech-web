{
  "name": "kangaro-tech-web",
  "private": true,
  "version": "2.0.0",
  "description": "KANGARO TECH marketing website — static HTML, CSS (Tailwind), vanilla JS.",
  "scripts": {
    "build:css": "tailwindcss -i ./src-css/tailwind.css -o ./assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src-css/tailwind.css -o ./assets/css/style.css --watch",
    "serve": "npx --yes http-server . -p 5173 -c-1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
